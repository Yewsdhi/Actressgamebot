
{
  "name": "Actress Photo Guess Bot",
  "description": "Automatic Actress Photo Guess Telegram Bot",
  "repository": "https://github.com/YOUR_GITHUB_USERNAME/YOUR_REPOSITORY",
  "keywords": ["telegram", "bot", "actress", "quiz"],
  "env": {
    "BOT_TOKEN": {
      "description": "Telegram Bot Token",
      "required": true
    },
    "ADMIN_IDS": {
      "description": "Telegram Admin ID",
      "required": true
    },
    "AUTO_POST_ENABLED": {
      "value": "true"
    },
    "AUTO_POST_INTERVAL_MINUTES": {
      "value": "15"
    },
    "AUTO_POST_CHAT_ID": {
      "description": "Channel username",
      "required": false
    }
  },
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "eco"
    }
  },
  "buildpacks": [
    {
      "url": "heroku/python"
    }
  ]
}
